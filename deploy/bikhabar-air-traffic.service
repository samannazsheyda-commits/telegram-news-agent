[Unit]
Description=Build Bikhabar live Middle East air traffic preview
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bikhabar
Group=bikhabar
WorkingDirectory=/opt/bikhabar/app
EnvironmentFile=/etc/bikhabar/agent.env
# Temporary safety gate: keep fetching/rendering live aircraft data for preview,
# but do not auto-publish until the approved visual map is implemented.
ExecStart=/opt/bikhabar/venv/bin/python -m src.air_traffic --output /var/lib/bikhabar/runtime/data/middle-east-air-traffic.png
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
