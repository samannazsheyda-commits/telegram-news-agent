[Unit]
Description=Publish Bikhabar live Iran-region air traffic snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bikhabar
Group=bikhabar
WorkingDirectory=/opt/bikhabar/app
EnvironmentFile=/etc/bikhabar/agent.env
ExecStart=/opt/bikhabar/venv/bin/python -m src.air_traffic --publish --output /var/lib/bikhabar/runtime/data/iran-region-live-air-traffic.png
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
