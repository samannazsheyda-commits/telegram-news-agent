[Unit]
Description=Publish Bikhabar air traffic snapshot at 00:00 Tehran daily

[Timer]
# Iran uses UTC+03:30 year-round; 00:00 Tehran = 20:30 UTC on the prior UTC date.
OnCalendar=*-*-* 20:30:00 UTC
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=bikhabar-air-traffic.service

[Install]
WantedBy=timers.target
