[Unit]
Description=Bikhabar Telegram News Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bikhabar
Group=bikhabar
WorkingDirectory=/opt/bikhabar/app
EnvironmentFile=/etc/bikhabar/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=POLL_SECONDS=5
Environment=SESSION_SECONDS=0
ExecStart=/opt/bikhabar/venv/bin/python -m src.newsroom_hybrid_runtime --monitor
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
