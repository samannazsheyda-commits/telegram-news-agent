[Unit]
Description=Bikhabar Newsroom Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bikhabar
Group=bikhabar
WorkingDirectory=/opt/bikhabar/app
EnvironmentFile=/etc/bikhabar/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=PANEL_LOCAL_ROOT=/opt/bikhabar/app
ExecStart=/opt/bikhabar/venv/bin/gunicorn --workers 2 --threads 2 --timeout 45 --bind 0.0.0.0:8080 panel.wsgi:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
