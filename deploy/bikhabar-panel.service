[Unit]
Description=Bikhabar Newsroom Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bikhabar
Group=bikhabar
WorkingDirectory=/opt/bikhabar/app
EnvironmentFile=/etc/bikhabar/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=BIKHABAR_RUNTIME_ROOT=/var/lib/bikhabar/runtime
Environment=PANEL_LOCAL_ROOT=/var/lib/bikhabar/runtime
Environment=PANEL_COMMAND_DIR=/var/lib/bikhabar/runtime/panel_commands
ExecStart=/opt/bikhabar/venv/bin/gunicorn --workers 2 --threads 2 --timeout 45 --bind 0.0.0.0:80 panel.wsgi:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
